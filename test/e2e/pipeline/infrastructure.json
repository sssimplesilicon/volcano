{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "worker-type-prototype"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "worker-type-test-recovery",
        "namespace": "worker-type-prototype",
        "labels": {
          "scheduling.simplesilicon.com/recovery-journal": "v1"
        }
      },
      "data": {
        "intents.json": "{}"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "test-recovery",
        "namespace": "worker-type-prototype"
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods/eviction"
          ],
          "verbs": [
            "create"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "configmaps"
          ],
          "resourceNames": [
            "worker-type-test-recovery"
          ],
          "verbs": [
            "get",
            "update"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "test-recovery",
        "namespace": "worker-type-prototype"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "test-recovery"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "volcano-scheduler",
          "namespace": "volcano-system"
        }
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "worker-type-test",
        "namespace": "volcano-system"
      },
      "data": {
        "volcano-scheduler.conf": "actions: \"enqueue, allocate, worker-type-preempt, backfill\"\ntiers:\n- plugins:\n  - name: worker-type-preemption\n    arguments:\n      victimQueue: wt-shared\n      pipelineBudgets: true\n  - name: priority\n  - name: gang\n    enablePreemptable: false\n  - name: conformance\n- plugins:\n  - name: predicates\n  - name: proportion\n\nconfigurations:\n- name: worker-type-preempt\n  arguments:\n    recoveryNamespace: worker-type-prototype\n    recoveryName: worker-type-test-recovery\n    evictionTimeoutSeconds: 2\n    pipelineBudgets: true\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "worker-type-test",
        "namespace": "volcano-system"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "worker-type-test"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "worker-type-test"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "scheduler",
                "image": "volcano-ss:v1.15.3-ss.1-local",
                "imagePullPolicy": "Never",
                "args": [
                  "--scheduler-name=worker-type-test",
                  "--scheduler-conf=/volcano.scheduler/volcano-scheduler.conf",
                  "--leader-elect=false",
                  "--logtostderr",
                  "-v=4",
                  "--schedule-period=1s",
                  "--master=http://127.0.0.1:18080",
                  "--enable-worker-type-preemption=true"
                ],
                "volumeMounts": [
                  {
                    "name": "scheduler-config",
                    "mountPath": "/volcano.scheduler"
                  }
                ],
                "command": [
                  "/vc-scheduler"
                ]
              },
              {
                "name": "fault-proxy",
                "image": "worker-type-prototype:v7-e2e-final",
                "imagePullPolicy": "Never",
                "command": [
                  "/faultproxy"
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/__fault/config",
                    "port": 18080
                  },
                  "periodSeconds": 1
                }
              },
              {
                "name": "budget-controller",
                "image": "volcano-ss:v1.15.3-ss.1-local",
                "imagePullPolicy": "Never",
                "command": [
                  "/budget-controller"
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "priorityClassName": "system-cluster-critical",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "seLinuxOptions": {
                "level": "s0:c123,c456"
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccount": "volcano-scheduler",
            "serviceAccountName": "volcano-scheduler",
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "scheduler-config",
                "configMap": {
                  "name": "worker-type-test"
                }
              }
            ],
            "nodeSelector": {
              "node-role.kubernetes.io/control-plane": "true"
            }
          }
        }
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "worker-type-test-budgets"
      },
      "rules": [
        {
          "apiGroups": [
            "scheduling.simplesilicon.com"
          ],
          "resources": [
            "pipelinepolicies",
            "workerbudgets"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            "scheduling.simplesilicon.com"
          ],
          "resources": [
            "workerbudgets/status"
          ],
          "verbs": [
            "update"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "worker-type-test-budgets"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "worker-type-test-budgets"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "volcano-scheduler",
          "namespace": "volcano-system"
        }
      ]
    }
  ]
}
