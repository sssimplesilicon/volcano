{
  "apiVersion": "kyverno.io/v1",
  "kind": "ClusterPolicy",
  "metadata": {
    "name": "arena-pytorch-independent-routing"
  },
  "spec": {
    "admission": true,
    "background": false,
    "emitWarning": false,
    "rules": [
      {
        "context": [
          {
            "name": "replicaBatches",
            "variable": {
              "jmesPath": "map(&not_null(template.spec.nodeSelector.batch, ''), values(request.object.spec.pytorchReplicaSpecs))"
            }
          },
          {
            "name": "effectiveBatch",
            "variable": {
              "jmesPath": "request.object.metadata.labels.batch || replicaBatches[0] || ''"
            }
          },
          {
            "name": "route",
            "variable": {
              "jmesPath": "contains(`[\"allocentric\", \"old-5880\"]`, effectiveBatch) && 'shared' || 'default'"
            }
          },
          {
            "name": "queue",
            "variable": {
              "jmesPath": "route == 'shared' && 'legacy-shared' || 'default'"
            }
          }
        ],
        "match": {
          "any": [
            {
              "resources": {
                "kinds": [
                  "kubeflow.org/v1/PyTorchJob"
                ],
                "namespaces": [
                  "wr-e2e-allow",
                  "wr-e2e-deny",
                  "wr-e2e-outside"
                ],
                "operations": [
                  "CREATE"
                ]
              }
            }
          ]
        },
        "mutate": {
          "patchStrategicMerge": {
            "metadata": {
              "labels": {
                "scheduling.simplesilicon.com/training-routing-version": "v1"
              }
            },
            "spec": {
              "runPolicy": {
                "schedulingPolicy": {
                  "queue": "{{ queue }}"
                }
              }
            }
          }
        },
        "name": "route-new-pytorchjob",
        "preconditions": {
          "all": [
            {
              "key": "{{ request.object.metadata.labels.\"routing.example.org/controller\" || '' }}",
              "operator": "NotEquals",
              "value": "old"
            }
          ]
        },
        "skipBackgroundRequests": true
      },
      {
        "context": [
          {
            "name": "replicaBatches",
            "variable": {
              "jmesPath": "map(&not_null(template.spec.nodeSelector.batch, ''), values(request.object.spec.pytorchReplicaSpecs))"
            }
          },
          {
            "name": "effectiveBatch",
            "variable": {
              "jmesPath": "request.object.metadata.labels.batch || replicaBatches[0] || ''"
            }
          },
          {
            "name": "route",
            "variable": {
              "jmesPath": "contains(`[\"allocentric\", \"old-5880\"]`, effectiveBatch) && 'shared' || 'default'"
            }
          },
          {
            "name": "queue",
            "variable": {
              "jmesPath": "route == 'shared' && 'legacy-shared' || 'default'"
            }
          }
        ],
        "match": {
          "any": [
            {
              "resources": {
                "kinds": [
                  "kubeflow.org/v1/PyTorchJob"
                ],
                "namespaces": [
                  "wr-e2e-allow",
                  "wr-e2e-deny",
                  "wr-e2e-outside"
                ],
                "operations": [
                  "CREATE"
                ]
              }
            }
          ]
        },
        "mutate": {
          "foreach": [
            {
              "list": "keys(request.object.spec.pytorchReplicaSpecs)",
              "patchStrategicMerge": {
                "spec": {
                  "pytorchReplicaSpecs": {
                    "{{ element }}": {
                      "template": {
                        "metadata": {
                          "annotations": {
                            "scheduling.volcano.sh/queue-name": "{{ queue }}"
                          },
                          "labels": {
                            "scheduling.simplesilicon.com/training-routing-version": "v1"
                          }
                        },
                        "spec": {
                          "nodeSelector": {
                            "volcano.sh/nodegroup-name": "{{ route == 'shared' && 'infra-ego-pipeline' || 'general' }}"
                          },
                          "schedulerName": "default-scheduler"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "name": "route-replica-templates",
        "preconditions": {
          "all": [
            {
              "key": "{{ request.object.metadata.labels.\"routing.example.org/controller\" || '' }}",
              "operator": "NotEquals",
              "value": "old"
            }
          ]
        },
        "skipBackgroundRequests": true
      },
      {
        "context": [
          {
            "name": "replicaBatches",
            "variable": {
              "jmesPath": "map(&not_null(template.spec.nodeSelector.batch, ''), values(request.object.spec.pytorchReplicaSpecs))"
            }
          },
          {
            "name": "effectiveBatch",
            "variable": {
              "jmesPath": "request.object.metadata.labels.batch || replicaBatches[0] || ''"
            }
          },
          {
            "name": "route",
            "variable": {
              "jmesPath": "contains(`[\"allocentric\", \"old-5880\"]`, effectiveBatch) && 'shared' || 'default'"
            }
          },
          {
            "name": "queue",
            "variable": {
              "jmesPath": "route == 'shared' && 'legacy-shared' || 'default'"
            }
          }
        ],
        "match": {
          "any": [
            {
              "resources": {
                "kinds": [
                  "kubeflow.org/v1/PyTorchJob"
                ],
                "namespaces": [
                  "wr-e2e-allow",
                  "wr-e2e-deny",
                  "wr-e2e-outside"
                ],
                "operations": [
                  "CREATE"
                ]
              }
            }
          ]
        },
        "name": "reject-inconsistent-replica-batch",
        "preconditions": {
          "all": [
            {
              "key": "{{ request.object.metadata.labels.\"routing.example.org/controller\" || '' }}",
              "operator": "NotEquals",
              "value": "old"
            }
          ]
        },
        "skipBackgroundRequests": true,
        "validate": {
          "allowExistingViolations": true,
          "foreach": [
            {
              "deny": {
                "conditions": {
                  "any": [
                    {
                      "key": "{{ element.template.spec.nodeSelector.batch || '' }}",
                      "operator": "NotEquals",
                      "value": "{{ replicaBatches[0] }}"
                    }
                  ]
                }
              },
              "list": "values(request.object.spec.pytorchReplicaSpecs)"
            }
          ],
          "message": "All PyTorchJob replica templates must have identical nodeSelector.batch values (missing counts as empty)."
        }
      }
    ],
    "validationFailureAction": "Enforce",
    "webhookConfiguration": {
      "failurePolicy": "Fail",
      "timeoutSeconds": 10
    }
  }
}
