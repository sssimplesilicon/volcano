                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "minItems": 1,
                        "x-kubernetes-list-type": "set",
                        "maxItems": 128
                      },
                      "exclude": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "x-kubernetes-list-type": "set",
                        "maxItems": 128
                      }
                    }
                  },
                  "schedulerName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
