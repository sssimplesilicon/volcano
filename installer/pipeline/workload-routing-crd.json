{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "workloadroutingpolicies.scheduling.simplesilicon.com"
  },
  "spec": {
    "group": "scheduling.simplesilicon.com",
    "scope": "Cluster",
    "names": {
      "plural": "workloadroutingpolicies",
      "singular": "workloadroutingpolicy",
      "kind": "WorkloadRoutingPolicy",
      "shortNames": [
        "wrp"
      ]
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "required": [
              "spec"
            ],
            "properties": {
              "apiVersion": {
                "type": "string",
                "maxLength": 253
              },
              "kind": {
                "type": "string",
                "maxLength": 253
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "required": [
                  "namespaceScope",
                  "schedulerName",
                  "rules",
                  "fallback"
                ],
                "properties": {
                  "namespaceScope": {
                    "type": "object",
                    "required": [
                      "include"
                    ],
                    "properties": {
                      "include": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "minItems": 1,
                        "x-kubernetes-list-type": "set",
                        "maxItems": 128
                      },
                      "exclude": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "x-kubernetes-list-type": "set",
                        "maxItems": 128
                      }
                    }
                  },
                  "schedulerName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "rules": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "match",
                        "target"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "match": {
                          "type": "object",
                          "properties": {
                            "labels": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string",
                                "maxLength": 253
                              },
                              "maxProperties": 32
                            },
                            "batchValues": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 253
                              },
                              "minItems": 1,
                              "x-kubernetes-list-type": "set",
                              "maxItems": 128
                            },
                            "legacyBatch": {
                              "type": "boolean",
                              "default": false
                            },
                            "absentLabels": {
                              "type": "array",
                              "x-kubernetes-list-type": "set",
                              "maxItems": 16,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 253
                              }
                            }
                          },
                          "x-kubernetes-validations": [
                            {
                              "rule": "(has(self.labels) && size(self.labels) > 0) || (has(self.batchValues) && size(self.batchValues) > 0)",
                              "message": "match must contain labels or batchValues"
                            },
                            {
                              "rule": "!self.legacyBatch || (has(self.batchValues) && (!has(self.labels) || !('pipeline.simplesilicon.com/name' in self.labels)))",
                              "message": "legacyBatch requires batch values and excludes explicit pipeline matching"
                            }
                          ]
                        },
                        "queueAccessPolicyRef": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253,
                          "description": "Deprecated compatibility field. Unified workload-policy ignores namespace queue authorization and emits a warning; omit in new policies."
                        },
                        "target": {
                          "type": "object",
                          "required": [
                            "queue",
                            "nodeGroup"
                          ],
                          "properties": {
                            "queue": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "nodeGroup": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "poolRef": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "cpuOnly": {
                              "type": "boolean"
                            },
                            "preemptionTarget": {
                              "type": "object",
                              "description": "Optional frozen target for new PyTorchJob replica Pods. Does not grant preemption authorization.",
                              "required": [
                                "name",
                                "namespace"
                              ],
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 63,
                                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                                },
                                "namespace": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 63,
                                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                                }
                              }
                            },
                            "priorityClassName": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "worker": {
                              "type": "object",
                              "required": [
                                "pipeline",
                                "namespace",
                                "type"
                              ],
                              "properties": {
                                "pipeline": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 63
                                },
                                "namespace": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 63
                                },
                                "type": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 63
                                }
                              }
                            }
                          },
                          "x-kubernetes-validations": [
                            {
                              "rule": "!has(self.preemptionTarget) || !has(self.cpuOnly) || !self.cpuOnly",
                              "message": "cpuOnly routes cannot specify preemptionTarget"
                            },
                            {
                              "rule": "!has(self.worker) || (has(self.priorityClassName) && !has(self.preemptionTarget) && (!has(self.cpuOnly) || !self.cpuOnly))",
                              "message": "worker requires priorityClassName and cannot be combined with preemptionTarget/cpuOnly"
                            }
                          ]
                        }
                      },
                      "x-kubernetes-validations": [
                        {
                          "rule": "!has(self.queueAccessPolicyRef) || self.queueAccessPolicyRef == self.target.queue",
                          "message": "queueAccessPolicyRef must equal target.queue"
                        }
                      ]
                    },
                    "x-kubernetes-list-type": "map",
                    "x-kubernetes-list-map-keys": [
                      "name"
                    ]
                  },
                  "fallback": {
                    "type": "object",
                    "required": [
                      "queue",
                      "nodeGroup"
                    ],
                    "properties": {
                      "queue": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "nodeGroup": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "poolRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "cpuOnly": {
                        "type": "boolean"
                      },
                      "preemptionTarget": {
                        "type": "object",
                        "description": "Optional frozen target for new PyTorchJob replica Pods. Does not grant preemption authorization.",
                        "required": [
                          "name",
                          "namespace"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63,
                            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                          },
                          "namespace": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63,
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                          }
                        }
                      },
                      "priorityClassName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "worker": {
                        "type": "object",
                        "required": [
                          "pipeline",
                          "namespace",
                          "type"
                        ],
                        "properties": {
                          "pipeline": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63
                          },
                          "namespace": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63
                          },
                          "type": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63
                          }
                        }
                      }
                    },
                    "x-kubernetes-validations": [
                      {
                        "rule": "!has(self.preemptionTarget) || !has(self.cpuOnly) || !self.cpuOnly",
                        "message": "cpuOnly routes cannot specify preemptionTarget"
                      },
                      {
                        "rule": "!has(self.worker) || (has(self.priorityClassName) && !has(self.preemptionTarget) && (!has(self.cpuOnly) || !self.cpuOnly))",
                        "message": "worker requires priorityClassName and cannot be combined with preemptionTarget/cpuOnly"
                      }
                    ]
                  },
                  "workloadKinds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "Pod",
                        "Deployment",
                        "StatefulSet",
                        "Job",
                        "CronJob",
                        "Workflow",
                        "PyTorchJob"
                      ]
                    },
                    "x-kubernetes-list-type": "set"
                  },
                  "controllerUsers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    },
                    "x-kubernetes-list-type": "set"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "Disabled",
                      "Preview",
                      "Enforce"
                    ]
                  }
                },
                "x-kubernetes-validations": [
                  {
                    "rule": "(!(has(self.fallback.preemptionTarget) || self.rules.exists(r, has(r.target.preemptionTarget)))) || !has(self.workloadKinds) || (size(self.workloadKinds) == 1 && self.workloadKinds[0] == \"PyTorchJob\")",
                    "message": "preemptionTarget requires a PyTorchJob-only policy"
                  }
                ]
              }
            }
          }
        }
      }
    ]
  }
}
