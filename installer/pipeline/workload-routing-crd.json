                "type": "string",
                "maxLength": 253
              },
              "kind": {
                "type": "string",
                "maxLength": 253
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "required": [
                  "namespaceScope",
