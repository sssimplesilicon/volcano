        "controllerUsers": [],
        "acceptedRoutes": [
          {
            "policyRef": "business-routing",
            "ruleNames": [
              "video-base",
              "video-shared"
            ]
          }
        ],
        "legacyRegistry": {
          "namespace": "kyverno",
          "name": "pipeline-isolation-grandfather"
