{
  "apiVersion": "scheduling.simplesilicon.com/v1alpha1",
  "kind": "WorkloadRoutingPolicy",
  "metadata": {
    "name": "arena-pytorch"
  },
  "spec": {
    "namespaceScope": {
      "include": [
        "infra-group"
      ],
      "exclude": [
        "kube-system",
        "volcano-system",
        "kyverno",
        "cert-manager",
        "argocd",
        "k8s-audit-system"
      ]
    },
    "schedulerName": "volcano-infra",
    "rules": [
      {
        "name": "ego-explicit",
        "match": {
          "labels": {
            "pipeline.simplesilicon.com/name": "ego-pipeline"
          },
          "batchValues": [
            "allocentric",
            "old-5880"
          ]
        },
        "target": {
          "queue": "infra-ego-pipeline-shared",
          "nodeGroup": "infra-ego-pipeline",
          "poolRef": "ego-pipeline"
        }
      },
      {
        "name": "ego-legacy",
        "match": {
          "batchValues": [
            "allocentric",
            "old-5880"
          ],
          "legacyBatch": true
        },
        "target": {
          "queue": "infra-ego-pipeline-shared",
          "nodeGroup": "infra-ego-pipeline",
          "poolRef": "ego-pipeline"
        }
      }
    ],
    "fallback": {
      "queue": "default",
      "nodeGroup": "general"
    },
    "workloadKinds": [
      "PyTorchJob"
    ],
    "controllerUsers": [],
    "mode": "Preview"
  }
}
